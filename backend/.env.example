# Application settings
PROJECT_NAME="Medical Reports"

# Authentication settings
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database settings
# Example for local MySQL:
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@localhost/medical_reports_db

# AI Service Configuration
AI_PROVIDER=openai  # or "azure"

# OpenAI settings (for testing)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Azure OpenAI settings (for production) - Optional
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o
AZURE_API_VERSION=2025-01-01-preview

# CORS settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173