# Application settings
PROJECT_NAME="Medical Reports"

# Authentication settings
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database settings
# Example for local MySQL:
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@localhost/medical_reports_db

# AI Service Configuration
# Choose one: "openai", "azure", or "uni"
AI_PROVIDER=uni

# OpenAI settings (if AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Azure OpenAI settings (if AI_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o
AZURE_API_VERSION=2025-01-01-preview

# University API settings (if AI_PROVIDER=uni)
# >>> HIER DEN API-SCHLÜSSEL VON DER UNI EINTRAGEN <<<
UNI_API_KEY=your-university-api-key-here
UNI_API_ENDPOINT=https://api.truhn.ai
UNI_API_MODEL=gpt-5

# CORS settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Umgebung: development | production (production schaltet /docs, /redoc, /openapi.json ab)
ENVIRONMENT=development

# Administratoren (Komma-getrennt): Studiendaten-Gesamtexport, globale Vorlagen-Migration
ADMIN_USERNAMES=admin,newmhayawi

# Log-Level fuer app.log/stdout (requests.log und errors.log unabhaengig davon)
LOG_LEVEL=INFO
